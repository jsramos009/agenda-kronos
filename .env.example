# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://auidksphelvjffwzzpre.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: only required by trusted server-side integrations such as public booking webhooks.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Used to build email confirmation redirects in hosted environments.
NEXT_PUBLIC_SITE_URL=https://agendakronos.vercel.app

# Resend: use a verified sender domain. These values are server-only.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=contato@your-domain.com

# Dedicated 32-byte base64 key used only to encrypt per-workspace Asaas credentials.
# Generate a new value for every deployment environment and never expose it publicly.
ASAAS_CREDENTIALS_ENCRYPTION_KEY=base64_encoded_32_byte_key
